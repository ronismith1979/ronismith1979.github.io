---
layout: base.njk
title: Ready-Made
description: "Ready-to-use brand identity packages, collateral and social media kits, icon and illustration sets, premium AI prompt packs and audio by Smith1979."
permalink: /ready-made/
listing: readymade
---
<section class="wrap page">
  <h1>Ready-Made</h1>
  <p class="lead">{{ readymade.intro }}</p>

  {% if collections.readymade | length or site.previewMode %}
  <ul class="tabs" aria-label="Sections">
    {%- for sec in readymade.sections %}{% set n = collections.readymade | byCategory(sec.slug) | count %}{% if n > 0 or site.previewMode %}
    <li><a href="#{{ sec.slug }}">{{ sec.name }} <span class="count">{{ n }}</span></a></li>
    {%- endif %}{% endfor %}
  </ul>
  {% endif %}

  {% for sec in readymade.sections %}
  {% set list = collections.readymade | byCategory(sec.slug) %}
  {% if list | length or site.previewMode %}
  <section class="block sound-section" id="{{ sec.slug }}">
    <h2>{{ sec.name }}</h2>
    {% if sec.intro %}<p class="lead">{{ sec.intro }}</p>{% endif %}
    {% if list | length %}
    <ul class="grid">{% for p in list %}{% include "readymade-card.njk" %}{% endfor %}</ul>
    {% else %}
    <p class="empty">Coming soon.</p>
    {% endif %}
  </section>
  {% endif %}
  {% endfor %}

  <div class="cta-band">
    <p>{{ readymade.note }}</p>
    <p class="hero-links"><a class="primary" href="/contact/">Get in touch</a></p>
  </div>
</section>

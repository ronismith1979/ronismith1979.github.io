{% from "icons.njk" import badge %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " — " + site.name) if title else site.title %}
  {% set pageDesc = description or summary or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if noindex or status == "soon" or site.previewMode or (listing and not (collections[listing] | published | length)) %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:type" content="{{ 'article' if cover else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ (cover | img) if cover else '/assets/img/og-default.png' }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Newsreader:opsz,wght@6..72,400..600&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>document.documentElement.classList.add("js")</script>
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {% if site.previewMode %}<div class="preview-bar">Preview mode: this site is not public yet and is hidden from search engines. Set "previewMode" to false in site.json to launch.</div>{% endif %}
  <header class="site-header">
    <div class="wrap bar">
      <a class="wordmark" href="/">{{ site.name }}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="bars" aria-hidden="true"></span><span class="sr">Menu</span></button>
      <nav id="site-nav" class="nav-wrap" aria-label="Main">
        <ul class="nav">
          {%- for item in site.nav %}{% set ready = item.show or (item.collection and (collections[item.collection] | published | length)) %}{% if ready or site.previewMode %}
          <li class="{% if item.dropdown %}has-sub {% endif %}{% if item.cta %}cta {% endif %}{% if not ready %}is-soon{% endif %}">
            <a href="{{ item.url }}"{% if page.url | startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}{% if not ready %}<span class="soon">soon</span>{% endif %}</a>
            {%- if item.dropdown == "categories" %}
            <ul class="sub">
              {%- for c in site.categories %}{% set n = collections.work | byCategory(c.slug) | count %}{% if n > 0 or site.previewMode %}
              <li><a href="{{ item.url }}{{ c.slug }}/">{{ c.name }} <span class="count">{{ n }}</span></a></li>
              {%- endif %}{% endfor %}
            </ul>
            {%- endif %}
          </li>
          {%- endif %}{% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <p>{{ site.fullName }}, {{ site.role | lower }} in {{ site.location }}.</p>
      <ul class="social">
        {% for s in site.socials %}<li><a href="{{ s.url }}" rel="me noopener" target="_blank">{{ badge(s.name) }}{{ s.name }}</a></li>{% endfor %}
      </ul>
    </div>
  </footer>
  <script>
  (function () {
    var b = document.querySelector(".nav-toggle"), n = document.getElementById("site-nav");
    if (!b || !n) return;
    function set(open) { b.setAttribute("aria-expanded", open); n.classList.toggle("is-open", open); }
    b.addEventListener("click", function () { set(b.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") set(false); });
    n.addEventListener("click", function (e) { if (e.target.closest("a")) set(false); });
  })();
  </script>
</body>
</html>

---
layout: base.njk
---
{% set sec = sound.sections | sectionFor(type) %}
<article class="wrap project">
  <header class="project-head">
    <p class="crumb"><a href="/sounds/">Sounds</a> / <a href="/sounds/#{{ sec.slug }}">{{ sec.name }}</a></p>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lead">{{ summary }}</p>{% endif %}
    <dl class="meta">
      {% if genre %}<div><dt>Genre</dt><dd>{{ genre }}</dd></div>{% endif %}
      {% if role %}<div><dt>Role</dt><dd>{{ role }}</dd></div>{% endif %}
      {% if with %}<div><dt>With</dt><dd>{{ with }}</dd></div>{% endif %}
      {% if year %}<div><dt>Year</dt><dd>{{ year }}</dd></div>{% endif %}
    </dl>
    {% if links %}<p class="hero-links">{% for l in links %}<a href="{{ l.url }}" rel="noopener" target="_blank">{{ l.label }}</a>{% endfor %}</p>{% endif %}
  </header>

  {% if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}

  {% if tracks %}
  <section class="tracks">
    <h2>Listen</h2>
    {% for t in tracks %}
    <figure class="track">
      <figcaption>{{ t.title }}</figcaption>
      <audio controls preload="none" src="{{ (t.file | img) if t.file else t.url }}" aria-label="{{ t.title }}"></audio>
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  {% include "gallery.njk" %}

  {% set more = collections.sounds | siblings(page, 3, sec.sort) %}
  {% if more | length %}
  <section class="more">
    <h2>More in {{ sec.name }}</h2>
    <ul class="grid">{% for p in more %}{% include "sound-card.njk" %}{% endfor %}</ul>
  </section>
  {% endif %}
</article>
<script type="application/ld+json">
{{ {"@context":"https://schema.org","@type":("MusicGroup" if type == "project" else "CreativeWork"),"name":title,"genre":genre,"creator":{"@type":"Person","name":site.fullName,"alternateName":site.name},"url":(site.url + page.url),"description":summary,"sameAs":((links | pluck("url")) if links else [])} | dump | safe }}
</script>

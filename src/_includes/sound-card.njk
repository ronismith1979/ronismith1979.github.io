<li class="card">
  <a href="{{ p.url }}">
    <div class="card-media">
      {% if p.data.draft %}<span class="badge-draft">Draft</span>{% endif %}
      <img src="{{ p.data.cover | img }}" alt="{{ p.data.title }}" loading="lazy" decoding="async" width="800" height="600">
    </div>
    <h3>{{ p.data.title }}</h3>
    <p>{{ p.data.genre }}{% if p.data.genre and p.data.year %}, {% endif %}{{ p.data.year }}</p>
  </a>
</li>
